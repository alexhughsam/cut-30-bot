# Copy to .env (or export in your shell) — never commit real keys.

# YouTube Data API v3 key — enables live niche search, channel baselines,
# outlier scores, and stat refresh. Free:
#   console.cloud.google.com → create project → enable "YouTube Data API v3"
#   → Credentials → Create API key
YOUTUBE_API_KEY=

# Anthropic API key — enables Claude hook/format analysis and script drafting.
#   console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Optional overrides
# PORT=4173
# RIFTBOUND_CLAUDE_MODEL=claude-opus-4-8
# RIFTBOUND_DATA_DIR=./data
